[Unit]
Description=TaxBandits Payroll Compliance Engine
After=godbledger.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/wh-engine/.env
ExecStart=/usr/local/bin/wh-engine --month
# Use a bash subshell to expand the environment variable
ExecStartPost=/bin/bash -c 'curl -fsS --retry 3 https://hc-ping.com/${HC_UUID}'

[Install]
WantedBy=default.target
